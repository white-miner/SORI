# Copy this file to `.env` and fill in your project values.
# Do not commit real keys. CI builds use GitHub Secrets + dart-define.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_or_publishable_key
OPENAI_API_KEY=sk-your-openai-api-key
SITE_URL=https://white-miner.github.io/SORI/

# C.S1 basemap compare only (optional). Do not commit real keys.
# Domain-restrict keys if used in web builds. Prefer Edge proxy later (C.S2).
# STADIA_MAPS_API_KEY=
# MAPTILER_API_KEY=

# Auth (Supabase Dashboard):
